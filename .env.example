# ⚡ NESTYK — Frontend (root `.env`)
# Copy: cp .env.example .env
# ใช้โดย apps/web (Next) + apps/consumer-app (Expo)

NODE_ENV=development

# Web / Marketplace
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Consumer Mobile (Expo)
EXPO_PUBLIC_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_APP_ENV=development
# Default shell role on cold start: guest | tenant | owner | agent | admin
EXPO_PUBLIC_DEFAULT_ROLE=agent

# Dev login (local / clone) — must match docs/new-project/docker/seed-dev-user.sql
# Sample: admin@jitsamrit.com / Jitsamrit2026
EXPO_PUBLIC_USE_DEV_AUTH=true
EXPO_PUBLIC_DEV_LOGIN_EMAIL=admin@jitsamrit.com
EXPO_PUBLIC_DEV_LOGIN_PASSWORD=Jitsamrit2026
EXPO_PUBLIC_DEV_LOGIN_UUID=00000000-0000-4000-8000-000000000001
EXPO_PUBLIC_DEV_LOGIN_FIRST_NAME=Admin
EXPO_PUBLIC_DEV_LOGIN_LAST_NAME=Jitsamrit
EXPO_PUBLIC_ALLOW_DEV_ROLE_GRANT=true

# Supabase client (browser / mobile) — anon key only
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Maps display (Expo native Maps SDK / optional Embed)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
