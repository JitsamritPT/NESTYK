# ⚡ NESTYK Backend API Environment Variables

# Application
PORT=4000
NODE_ENV=development

# 🗄️ PostgreSQL via Supabase Connection Pooler
# รูปแบบ: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:password@localhost:5432/nestyk_db
DB_SCHEMA=NESTYK_PROPTECH

# 🔐 Supabase Cloud Config (Auth & Storage CDN)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 📦 Storage Buckets
SUPABASE_BUCKET_PROPERTIES=property-images
SUPABASE_BUCKET_CONTRACTS=contracts
