# ⚡ NESTYK — Backend API (root `.env.api`)
# Copy: cp .env.api.example .env.api
# โหลดโดย apps/api เท่านั้น

NODE_ENV=development
PORT=4000

# 🗄️ PostgreSQL — local (docker compose)
# docker compose up -d && ./docs/new-project/docker/apply-schema.sh
DATABASE_URL=postgresql://postgres:password@localhost:5432/nestyk_db
DB_SCHEMA=public

# 🔐 Supabase (server)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Local auth without real Supabase JWT (Bearer dev|<uuid>|<email>|…)
ALLOW_DEV_AUTH=true
# Dev grant/revoke roles via POST|DELETE /auth/dev/roles
ALLOW_DEV_ROLE_GRANT=true

# After schema apply, seed portable sample profile:
#   ./docs/new-project/docker/seed-dev-user.sh
# Login (mobile): admin@jitsamrit.com / Jitsamrit2026
# UUID: 00000000-0000-4000-8000-000000000001

# 📦 Storage Buckets
SUPABASE_BUCKET_PROPERTIES=property-images
SUPABASE_BUCKET_CONTRACTS=contracts

# Google Places (New) — server proxy for listing address autocomplete
GOOGLE_MAPS_API_KEY=
